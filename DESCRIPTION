Package: fast.string
Type: Package
Title: Fast Parallel String Functions via PCRE2 and RcppParallel
Version: 0.3.0
Authors@R: c(
    person("Kyle", "Haynes", email = "kyle@kylehaynes.com.au", role = c("aut", "cre")),

\code{\link[=rLink_unmatched]{rLink_unmatched()}},
\code{\link[=select_greedy]{select_greedy()}},
\code{\link[=sorted_neighbourhood]{sorted_neighbourhood()}}
}
\concept{record linkage pair functions}
